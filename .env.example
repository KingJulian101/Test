# Copy to .env and edit before running `docker compose up -d`.

# Your public hostname (Caddy fetches a Let's Encrypt certificate for it).
DOMAIN=rooms.example.co.uk

# Session signing key - make it long and random, e.g.:  openssl rand -hex 32
SECRET_KEY=change-me

# First admin account, created automatically on first start only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
ADMIN_FULL_NAME=Practice Manager

# Optional tweaks
SITE_NAME=Alcester Health Centre Rooms
DAY_START=07:00
DAY_END=20:00
SLOT_MINUTES=15
